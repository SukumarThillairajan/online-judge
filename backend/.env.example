# PostgreSQL connection string (Supabase or local)
DATABASE_URL=postgresql://user:password@host:5432/database

# JWT signing secret.
# Generate with:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET_KEY=

# API port (optional, defaults to 3000)
PORT=3000

# Redis connection string, used by BullMQ and the interview transcript cache
REDIS_HOST=
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# Set to "production" to enable secure + sameSite=none cookies (requires HTTPS)
NODE_ENV=development

# Google Gemini API key for the AI interviewer and grader
GEMINI_API_KEY=
