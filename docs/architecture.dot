digraph Ascend {
  rankdir=TB; compound=true; splines=true;
  nodesep=0.32; ranksep=0.40; bgcolor="white"; fontname="Helvetica";
  node [fontname="Helvetica", fontsize=11, shape=box, style="rounded,filled", penwidth=1.3, margin="0.15,0.10"];
  edge [fontname="Helvetica", fontsize=9, color="#4d5a6b", penwidth=1.3, arrowsize=0.7];

  subgraph cluster_client {
    label=<<b>CLIENT</b>  ·  Vercel CDN>;
    fontsize=11.5; fontcolor="#1d4ed8"; color="#8fb2fb"; style="rounded,filled"; fillcolor="#f5f9ff"; margin=11;
    ui   [label=<<b>React 19 + Vite SPA</b><br/><font point-size="8.5">TanStack Query · Router 7</font>>, fillcolor="#cfe0ff", color="#6d97f5"];
    mon  [label=<<b>Monaco Editor</b><br/><font point-size="8.5">compile-error<br/>line highlight</font>>, fillcolor="#e3edff", color="#89a9f5"];
    chat [label=<<b>AI Chatbox</b><br/><font point-size="8.5">SSE reader<br/>45-min timer</font>>, fillcolor="#e3edff", color="#89a9f5"];
    {rank=same; mon; chat;}
    ui -> mon [style=invis]; ui -> chat [style=invis];
  }

  subgraph cluster_ec2 {
    label=<<b>AWS EC2</b>  ·  docker-compose  ·  image from ECR>;
    fontsize=11.5; fontcolor="#b45309"; color="#eab676"; style="rounded,filled"; fillcolor="#fffbf3"; margin=12;

    subgraph cluster_api {
      label=<<b>api</b>  ·  Express 5  ·  JWT cookie  ·  CORS>;
      fontsize=10; fontcolor="#92400e"; color="#e0b273"; style="rounded,filled"; fillcolor="#fff5e6"; margin=9;
      auth [label=<<b>/api/auth</b><br/><font point-size="8">JWT · bcrypt · RBAC</font>>, fillcolor="#ffe8c6", color="#d9a44c"];
      prob [label=<<b>/api/problems</b><br/><font point-size="8">best-rank CTE</font>>, fillcolor="#ffe8c6", color="#d9a44c"];
      subm [label=<<b>/api/submissions</b><br/><font point-size="8">run · submit · status</font>>, fillcolor="#ffe8c6", color="#d9a44c"];
      intv [label=<<b>/api/interviews</b><br/><font point-size="8">start · chat · finish<br/>6 req/min/IP</font>>, fillcolor="#ffe8c6", color="#d9a44c"];
      {rank=same; auth; prob;}
      {rank=same; subm; intv;}
      auth -> subm [style=invis]; prob -> intv [style=invis];
    }

    redis [label=<<b>redis</b>  ·  <font point-size="9">compose service</font><br/><font point-size="8.5">BullMQ queue · interview:chat 2 h TTL</font><br/><font point-size="8.5">run-code results 300 s TTL</font>>, fillcolor="#d6efdd", color="#5aab70"];
    wrk   [label=<<b>worker</b>  ·  BullMQ consumer<br/><font point-size="8.5">concurrency 5 · 3 retries · stall recovery</font><br/><font point-size="8.5">evaluate-code · run-code</font>>, fillcolor="#ffe8c6", color="#d9a44c"];
    sbx   [label=<<b>Ephemeral Docker Sandbox</b><br/><font point-size="8.5">one container per compile / per test case</font><br/><font point-size="8.5"><b>--rm --network none --memory 256m</b></font><br/><font point-size="8.5">gcc-alpine · corretto:21 · python:3.11 · node:20</font><br/><font point-size="8.5">3 s → SIGTERM = TLE  ·  exit 137 = MLE</font>>, fillcolor="#ffdcdc", color="#d06a6a"];
  }

  pg [label=<<b>PostgreSQL</b>  ·  Supabase<br/><font point-size="8.5">Drizzle ORM · versioned migrations</font><br/><font point-size="8.5">users · problems · test_cases</font><br/><font point-size="8.5">submissions · interview_sessions</font>>, fillcolor="#d6efdd", color="#5aab70"];
  ai [label=<<b>Google Gemini</b><br/><font point-size="8.5">gemini-3.1-flash-lite</font><br/><font point-size="8.5">interviewer (SSE stream)</font><br/><font point-size="8.5">grader (JSON mode)</font>>, fillcolor="#d6efdd", color="#5aab70"];

  ui   -> prob [lhead=cluster_api, label=<<font point-size="8.5"> HTTPS · axios<br/> withCredentials </font>>];
  chat -> intv [color="#c2410c", penwidth=1.9, dir=both, label=<<font point-size="8.5"><b> POST<br/> + SSE </b></font>>];

  subm -> redis [label=<<font point-size="8.5"> enqueue </font>>];
  intv -> redis [label=<<font point-size="8.5"> transcript </font>>];
  redis -> wrk  [color="#b45309", penwidth=1.9, dir=both, label=<<font point-size="8.5"><b> dequeue </b></font>>];
  wrk  -> sbx   [color="#b91c1c", penwidth=1.9, dir=both, label=<<font point-size="8.5"><b> docker-cli via<br/> /var/run/docker.sock </b></font>>];

  {rank=same; pg; ai;}
  wrk  -> pg [label=<<font point-size="8.5"><b> verdict +<br/> errorDetails </b></font>>];
  subm -> pg [style=invis];
  intv -> ai [color="#15803d", penwidth=1.8, dir=both, label=<<font point-size="8.5"><b> transcript · live code<br/> ghost prompts </b></font>>];
}
